#!/usr/bin/env bash
#ddev-generated

## Description: Start DDEV projects automatically at boot (Linux) or login (macOS)
## Usage: autostart [enable|disable|status|list] [project-name...|--running|--registered|--all] | --version
## Example: "ddev autostart enable" (inside a project), "ddev autostart enable site-a shop", "ddev autostart enable --running" or "ddev autostart list"
## CanRunGlobally: true

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: ddev autostart <enable|disable|status> [project-name...]
       ddev autostart enable --running
       ddev autostart enable --registered
       ddev autostart disable --all
       ddev autostart list
       ddev autostart --version

  enable    Register projects to start automatically
            --running registers every project that is running right now
            --registered rewrites every registration (after an add-on update,
            or after moving docker or ddev)
  disable   Remove projects' autostart registrations (does not stop the projects)
            --all removes the registration of every project
  status    Show whether projects are registered and their last result
  list      Show every DDEV project with its autostart state

  --version Show the installed version, plugin and DDEV version (for bug reports)

Inside a project directory the project is detected automatically.
Anywhere else, pass one or more project names, e.g. `ddev autostart enable site-a shop`.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
SUPPORT_DIR="${SCRIPT_DIR}/autostart.d"

# shellcheck source=autostart.d/lib/resolve-approot.sh
source "${SUPPORT_DIR}/lib/resolve-approot.sh"
# shellcheck source=autostart.d/lib/list.sh
source "${SUPPORT_DIR}/lib/list.sh"
# shellcheck source=autostart.d/lib/detect.sh
source "${SUPPORT_DIR}/lib/detect.sh"

ACTION="${1:-}"
case "$ACTION" in
    enable | disable | status | list | --version) shift ;;
    "" | help | -h | --help) usage; exit 0 ;;
    *) echo "❌ Error: unknown action '$ACTION'." >&2; usage >&2; exit 1 ;;
esac

# --- OS / init system detection -----------------------------------------------
OS_TYPE="$(ddev_autostart_detect_plugin)"

# Works even on an unsupported system: it's what a bug report needs.
if [ "$ACTION" = "--version" ]; then
    if [ "$OS_TYPE" = "unknown" ]; then
        ddev_autostart_print_version "none (unsupported system)"
    else
        ddev_autostart_print_version "$OS_TYPE"
    fi
    exit 0
fi

if [ "$OS_TYPE" = "unknown" ]; then
    echo "❌ Error: Unsupported operating system or init system." >&2
    exit 1
fi

if ! PLUGIN_PATH="$(ddev_autostart_plugin_path "$SUPPORT_DIR" "$OS_TYPE")"; then
    echo "❌ Error: Plugin for '$OS_TYPE' is missing or not implemented yet." >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$PLUGIN_PATH"

# --- list: all projects, no project context needed ----------------------------
if [ "$ACTION" = "list" ]; then
    if [ -n "${1:-}" ]; then
        echo "❌ Error: 'list' takes no project name." >&2
        exit 1
    fi
    ddev_autostart_print_list
    ddev_autostart_print_install_footer
    exit 0
fi

# --- Arguments ----------------------------------------------------------------
# Names are validated as they are read, so they never contain whitespace and a
# plain space-separated string is safe to loop over (bash 3.2 has no reliable
# empty-array handling under `set -u`).
NAMES=""
OPT_ALL=""
OPT_RUNNING=""
OPT_REGISTERED=""
for arg in "$@"; do
    case "$arg" in
        --all) OPT_ALL=1 ;;
        --running) OPT_RUNNING=1 ;;
        --registered) OPT_REGISTERED=1 ;;
        -*) echo "❌ Error: unknown option '$arg'." >&2; usage >&2; exit 1 ;;
        *)
            if ! ddev_autostart_valid_name "$arg"; then
                echo "❌ Error: '$arg' is not a valid DDEV project name." >&2
                exit 1
            fi
            case " $NAMES " in *" $arg "*) ;; *) NAMES="${NAMES:+$NAMES }$arg" ;; esac
            ;;
    esac
done

if [ -n "$OPT_ALL" ] && [ "$ACTION" != "disable" ]; then
    if [ "$ACTION" = "enable" ]; then
        echo "❌ Error: 'enable --all' is not supported: it would also start old or broken projects every time." >&2
        echo "   Use 'ddev autostart enable --running' to register the projects running now." >&2
    else
        echo "❌ Error: --all only works with 'disable'." >&2
    fi
    exit 1
fi
if [ -n "$OPT_RUNNING" ] && [ "$ACTION" != "enable" ]; then
    echo "❌ Error: --running only works with 'enable'." >&2
    exit 1
fi
if [ -n "$OPT_REGISTERED" ] && [ "$ACTION" != "enable" ]; then
    echo "❌ Error: --registered only works with 'enable'." >&2
    exit 1
fi
if [ -n "$OPT_RUNNING" ] && [ -n "$OPT_REGISTERED" ]; then
    echo "❌ Error: use either --running or --registered, not both." >&2
    exit 1
fi
if { [ -n "$OPT_ALL" ] || [ -n "$OPT_RUNNING" ] || [ -n "$OPT_REGISTERED" ]; } && [ -n "$NAMES" ]; then
    echo "❌ Error: use either project names or --all/--running/--registered, not both." >&2
    exit 1
fi

# --- Which projects -------------------------------------------------------------
if [ -n "$OPT_ALL" ]; then
    NAMES="$(plugin_list_registered | cut -f1 | tr '\n' ' ')"
    NAMES="${NAMES% }"
    if [ -z "$NAMES" ]; then
        echo "ℹ️  No projects are registered for autostart."
        exit 0
    fi
elif [ -n "$OPT_REGISTERED" ]; then
    # Rewrite each registration as `enable` would now, but only those known to
    # be on: `enable` turns a registration on, so one the user turned off with
    # systemctl or launchctl, or whose state can't be read right now, is
    # skipped. So is a project that can't be found (enable would fail).
    registered="$(plugin_list_registered)"
    if [ -z "$registered" ]; then
        echo "ℹ️  No projects are registered for autostart."
        exit 0
    fi
    ddev_autostart_load_projects
    skipped=""
    while IFS=$'\t' read -r name state _; do
        [ -n "$name" ] || continue
        if [ -z "$(ddev_autostart_resolve_approot "$name" || true)" ]; then
            echo "Skipping ${name}: can't find the project or its folder. If you deleted it, remove the registration with: ddev autostart disable ${name}"
            skipped=1
        elif [ "$state" = "disabled" ]; then
            echo "Skipping ${name}: it was turned off. Turn it back on with: ddev autostart enable ${name}"
            skipped=1
        elif [ "$state" != "enabled" ]; then
            echo "Skipping ${name}: can't tell whether it's turned on (${state:-no state}). To update it anyway, which also turns it on: ddev autostart enable ${name}"
            skipped=1
        else
            NAMES="${NAMES:+$NAMES }$name"
        fi
    done <<<"$registered"
    if [ -z "$NAMES" ]; then
        echo "ℹ️  Nothing to update."
        exit 0
    fi
    [ -n "$skipped" ] && echo
    echo "Updating the registrations of: ${NAMES}"
elif [ -n "$OPT_RUNNING" ]; then
    ddev_autostart_load_projects
    projects="$DDEV_AUTOSTART_PROJECTS"
    if [ -n "$projects" ] && ! printf '%s\n' "$projects" | awk -F'\t' '$3 != "-" { found = 1 } END { exit !found }'; then
        echo "❌ Error: can't tell which projects are running (\`ddev list\` is unavailable). Is Docker running?" >&2
        exit 1
    fi
    NAMES="$(printf '%s\n' "$projects" | awk -F'\t' '$3 == "running" { printf "%s%s", sep, $1; sep = " " }')"
    if [ -z "$NAMES" ]; then
        echo "ℹ️  No DDEV projects are running, so there is nothing to register."
        exit 0
    fi
    echo "Registering the running projects: ${NAMES}"
elif [ -z "$NAMES" ]; then
    NAMES="${DDEV_PROJECT:-}"
    if [ -z "$NAMES" ]; then
        echo "❌ Error: No DDEV project detected. Run inside a project folder or specify project names." >&2
        exit 1
    fi
fi

# Fetch DDEV's project list once, but only if a name needs looking up: the
# current project's path comes from DDEV's environment for free.
for name in $NAMES; do
    if [ "$name" != "${DDEV_PROJECT:-}" ] || [ -z "${DDEV_APPROOT:-}" ]; then
        ddev_autostart_load_projects
        break
    fi
done

# Path of a project: the current project's from DDEV's environment, any other
# looked up by name. Empty if the project no longer exists.
approot_of() {
    if [ "$1" = "${DDEV_PROJECT:-}" ] && [ -n "${DDEV_APPROOT:-}" ]; then
        printf '%s\n' "$DDEV_APPROOT"
    else
        ddev_autostart_resolve_approot "$1" || true
    fi
}

# For enable, check every name before changing anything: a typo in the third
# name shouldn't leave the first two registered and the user unsure what happened.
if [ "$ACTION" = "enable" ]; then
    missing=""
    for name in $NAMES; do
        [ -n "$(approot_of "$name")" ] || missing="$missing $name"
    done
    if [ -n "$missing" ]; then
        echo "❌ Error: Could not find project(s):$missing. Check \`ddev list\` for the exact names. Nothing was changed." >&2
        exit 1
    fi
fi

# --registered rewrites a registration with the Docker and DDEV settings it was
# made with (DOCKER_HOST and the like), not the current shell's: a project
# registered for Colima must stay on Colima. Plugins that can't report them
# (plugin_registered_env is optional) use the current shell's.
enable_registered() {
    local line
    if declare -F plugin_registered_env >/dev/null; then
        unset DOCKER_HOST DOCKER_CONTEXT DOCKER_CONFIG DDEV_XDG_CONFIG_HOME
        while IFS= read -r line; do
            case "${line%%=*}" in
                DOCKER_HOST | DOCKER_CONTEXT | DOCKER_CONFIG | DDEV_XDG_CONFIG_HOME) export "${line?}" ;;
            esac
        done < <(plugin_registered_env "$1")
    fi
    plugin_enable "$1" "$2"
}

# --- Run ------------------------------------------------------------------------
failed=""
count=0
for name in $NAMES; do
    count=$((count + 1))
    [ "$count" -gt 1 ] && echo
    # `disable` and `status` must still work for a project that was deleted or moved.
    if [ -n "$OPT_REGISTERED" ]; then
        # In a subshell, so one project's settings don't carry over to the next.
        if ! (enable_registered "$name" "$(approot_of "$name")"); then
            failed="$failed $name"
        fi
    elif ! "plugin_${ACTION}" "$name" "$(approot_of "$name")"; then
        failed="$failed $name"
    fi
done

if [ "$ACTION" = "status" ]; then
    ddev_autostart_print_install_footer
fi

if [ -n "$failed" ]; then
    [ "$count" -gt 1 ] && echo "❌ Failed for:$failed" >&2
    exit 1
fi
